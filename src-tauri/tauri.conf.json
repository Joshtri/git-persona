{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitPersona",
  "version": "0.9.1",
  "identifier": "com.gitpersona",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxOERDMzY0MjkzMjI0OTEKUldTUkpESXBaTU9OZ1hFK3RIeFJqK0dWQ3hpeEVtRlZGOGNMVE1KSEprQVFTYnQrOHIvVjhXN3EK",
      "endpoints": [
        "https://api.gitpersona.app/update/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "GitPersona",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "visible": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  }
}
